# Copy to .env (git-ignored) and fill in. Never commit real values.
# Get an API key from https://dashboard.heycall-e.com/account/api-keys (20 free calls;
# request +200 via the credits form). The core runs credential-free with FakeCalle for dev/tests.
CALLE_API_KEY=iams_live_replace_me

# Optional webhook receiver base URL for call.completed / call.result_validation_failed
CALLE_WEBHOOK_BASE_URL=https://example.com

# Verification threshold (0..1). Answers below this confidence are never marked verified.
RELAYGOAL_CONFIDENCE_THRESHOLD=0.7
