# Copy to .env (git-ignored) and fill in. Never commit real values.
# The app runs credential-free with FakeCalle by default — no key needed for dev/tests/demo.

# --- Live CALL-E (optional) ---------------------------------------------------
# Going live takes TWO deliberate steps so the safe dry-run path stays the default:
#   1) install the optional SDK:  npm install @call-e/calle
#   2) set BOTH of the following, then restart.
# Get an API key at https://dashboard.heycall-e.com/account/api-keys
# (20 free calls on a new account; request +200 via the credits form).
CALLE_API_KEY=calle_live_replace_me
# Master switch. Live calls are placed ONLY when this is exactly "1" AND CALLE_API_KEY is set.
RELAYGOAL_LIVE=0
# Optional: override the API base (e.g. https://test-api.heycall-e.com for the test env).
CALLE_BASE_URL=

# Optional create-and-wait tuning (async finalization can take a while; do not tight-poll).
RELAYGOAL_CALL_TIMEOUT_MS=180000
RELAYGOAL_CALL_POLL_MS=3000

# Optional webhook receiver base URL for call.completed / call.result_validation_failed
CALLE_WEBHOOK_BASE_URL=https://example.com

# Verification threshold (0..1). Answers below this confidence are never marked verified.
RELAYGOAL_CONFIDENCE_THRESHOLD=0.7
